{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared/*": ["src/domains/shared/*"],
      "@identity/*": ["src/domains/identity/*"],
      "@rfq/*": ["src/domains/rfq/*"],
      "@quotation/*": ["src/domains/quotation/*"],
      "@order/*": ["src/domains/order/*"],
      "@wallet/*": ["src/domains/wallet/*"],
      "@payment/*": ["src/domains/payment/*"],
      "@shipment/*": ["src/domains/shipment/*"],
      "@invoice/*": ["src/domains/invoice/*"],
      "@notification/*": ["src/domains/notification/*"],
      "@admin/*": ["src/domains/admin/*"]
    }
  }
}
